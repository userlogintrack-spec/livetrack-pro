# ═══════════════════════════════════════════════
# LiveVisitorHub / LiveTrack Pro — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ───── REQUIRED in production ─────
SECRET_KEY=                          # python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,.yourdomain.com

# ───── Database (PostgreSQL) ─────
# Render / Heroku: paste the full connection URL
DATABASE_URL=postgresql://user:password@host:5432/livetrack_db
# Or use individual fields for local dev:
# DB_NAME=livetrack
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ───── Redis (REQUIRED for WebSocket + cache in production) ─────
# Render Key Value, Upstash, or self-hosted. TLS Upstash URL example:
# REDIS_URL=rediss://default:<password>@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ───── CSRF (production HTTPS domains) ─────
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://*.yourdomain.com

# ───── Field-level encryption ─────
# Protects TOTP secrets, webhook HMAC keys, AI API keys, WhatsApp tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the key is derived from SECRET_KEY (works for dev, but rotating
# SECRET_KEY then becomes destructive for encrypted fields — set explicitly in prod).
FIELD_ENCRYPTION_KEY=

# ───── Email (for password reset, magic links, scheduled reports) ─────
# This is the SYSTEM email account used by Django (notifications, magic links).
# Per-org Email-to-Chat mailboxes are configured in the dashboard UI, not here.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=                  # Gmail: use an App Password, not your account password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_TIMEOUT=30

# ───── Sentry error monitoring (optional but recommended for production) ─────
SENTRY_DSN=                           # https://xxx@sentry.io/yyy — leave blank to disable
SENTRY_ENV=production                 # production | staging | development
SENTRY_TRACES_RATE=0.1                # 0.0 to 1.0 — sample rate for performance traces
# SENTRY_RELEASE=v1.0.0               # optional, tag releases for regression tracking

# ───── Behind a proxy / CDN (Render, Heroku, Nginx)? ─────
TRUST_X_FORWARDED_FOR=True

# ───── Tunables ─────
CHAT_SLA_MINUTES=5                    # SLA breach threshold for waiting chats

# ═══════════════════════════════════════════════
# Cron / scheduled jobs (run on the platform's scheduler — Render Cron Jobs,
# system crontab, k8s CronJob, etc.). These DON'T need env vars; they just
# need to be scheduled to run periodically.
# ═══════════════════════════════════════════════
#
# Every 2-5 minutes (pulls customer support emails into the dashboard):
#     python manage.py poll_email_inboxes
#
# Every 1-5 minutes (retries failed webhook deliveries with exponential backoff):
#     python manage.py process_webhook_retries
#
# Every 5-15 minutes (sends auto-responder messages on long-waiting chats):
#     python manage.py send_auto_replies
#
# Daily at off-hours (deletes data per retention policy):
#     python manage.py purge_old_data
